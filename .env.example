# =====================================================================
# AI Kids Video Studio — root environment template
# Copy to .env and fill in. NEVER commit real secrets.
# In CI/CD use GitHub Secrets / your platform's secret manager instead.
# =====================================================================

# ---- Core security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-32-bytes-minimum
# One-click passwordless dev login button ("Continue as local dev").
# Default (unset): enabled automatically in local dev (no SECRET_KEY set) and
# disabled in production. Set explicitly to force on (true) or off (false).
# ALLOW_DEV_LOGIN=false
ACCESS_TOKEN_EXPIRE_MINUTES=720
FIRST_USER_IS_ADMIN=true

# ---- Database ----
# Development: sqlite (default). Production: PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg2://studio:studio@db:5432/studio
DATABASE_URL=sqlite:///./storage/studio.db

# ---- Storage ----
# local | s3 (S3 also covers Cloudflare R2 — set S3_ENDPOINT_URL)
STORAGE_BACKEND=local
MEDIA_ROOT=./storage/media
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- AI provider keys (all optional; local providers work without keys) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
PIKA_API_KEY=
RUNWAY_API_KEY=

# Default provider per capability: see GET /api/v1/meta/provider-catalog
TEXT_PROVIDER=local
IMAGE_PROVIDER=local
VIDEO_PROVIDER=local
VOICE_PROVIDER=local
MUSIC_PROVIDER=local

# ---- YouTube Data API v3 (OAuth 2.0 web client) ----
# Create credentials: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback
# Comma-separated OAuth scopes
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube

# ---- GitHub Actions long-job integration (optional) ----
# A fine-grained PAT with actions:write on this repo — store as a secret.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=owner/repo
# Shared secret used by workflow callbacks -> POST /api/v1/jobs/callback/{id}
JOB_CALLBACK_SECRET=change-me-job-callback-secret

# ---- Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma separated list of allowed CORS origins for the API
CORS_ORIGINS=*

# ---- Frontend (Next.js) ----
# Server-side proxy target used by frontend rewrites (NOT exposed to browser)
API_PROXY_TARGET=http://localhost:8000
